---
import Layout from '../layouts/Layout.astro';
import ResumeSection from '../components/ResumeSection.tsx';
import ExperienceTree from '../components/ExperienceTree.tsx';
import StudentRobot from '../components/StudentRobot.tsx';
import RobotAssembler from '../components/RobotAssembler.tsx';
import { profile, education, experience, skills } from '../data/profile';
import React from "react";
---

/*TODO: transform header to a little card on right of the nav and put nav on the left*/

<Layout title="Resume | Software Engineer Portfolio">
  <div class="min-h-screen">
    <!-- Resume Sections -->
    <section class="py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <!-- Section Navigation -->
          <!--TODO: when scroll stay on top-->
        <div class="flex justify-start mb-16">
          <div class="flex flex-wrap gap-4">
            <button 
              class="resume-nav-btn active px-6 py-3 rounded-lg font-medium transition-all duration-300"
              data-section="about"
            >
              <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              About
            </button>
            <button 
              class="resume-nav-btn px-6 py-3 rounded-lg font-medium transition-all duration-300"
              data-section="experience"
            >
              <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0H8m8 0v2a2 2 0 01-2 2H10a2 2 0 01-2-2V6m8 0H8"></path>
              </svg>
              Experience
            </button>
            <button 
              class="resume-nav-btn px-6 py-3 rounded-lg font-medium transition-all duration-300"
              data-section="education"
            >
              <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
              </svg>
              Education
            </button>
            <button 
              class="resume-nav-btn px-6 py-3 rounded-lg font-medium transition-all duration-300"
              data-section="skills"
            >
              <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
              </svg>
              Skills
            </button>
          </div>
        </div>

        <!-- Resume Content Sections -->
        <div id="resume-content" class="min-h-[600px]">
          <!-- About Section -->
          <div id="about-section" class="resume-section active">
              <ResumeSection
                      title="About Me"
                      client:load
              >
                  {/* Content */}
                  <div class="space-y-4">
                      {/* Bio */}
                      <div class="text-slate-300 leading-relaxed space-y-3">
                          <p class="text-base">
                              Curiosity is my compass. I thrive on learning new things, tackling challenges, and discovering solutions—honestly, problem-solving is my favorite dopamine hit. When I'm not at my computer, you'll find me hiking through nature with my wife and our dog, recharging for the next adventure.
                          </p>
                      </div>

                      <div class="bg-slate-700/50 rounded-xl p-4">
                          <h3 class="text-lg font-semibold text-white mb-3 flex items-center">
                              <svg class="w-5 h-5 mr-2 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                              </svg>
                              What Drives Me
                          </h3>
                          <div class="grid grid-cols-1 gap-3">
                              <div class="space-y-2">
                                  <div class="flex items-center space-x-2">
                                      <span class="w-2 h-2 bg-cyan-400 rounded-full"></span>
                                      <span class="text-slate-300">
                                          <span class="font-bold">Continuous Learning</span>
                                          – I'm always diving into something new, whether it's a technology, framework, or concept that pushes my thinking.
                                      </span>
                                  </div>
                                  <div class="flex items-center space-x-2">
                                      <span class="w-2 h-2 bg-purple-400 rounded-full"></span>
                                      <span class="text-slate-300">
                                          <span class="font-bold">Building Side Projects</span>
                                          – There's nothing quite like bringing an idea to life from scratch.
                                      </span>
                                  </div>
                                  <div class="flex items-center space-x-2">
                                      <span class="w-2 h-2 bg-blue-400 rounded-full"></span>
                                      <span class="text-slate-300">
                                          <span class="font-bold">Brazilian Jiu-Jitsu</span>
                                          – The perfect mix of strategy, discipline, and physical challenge.
                                      </span>
                                  </div>
                                  <div class="flex items-center space-x-2">
                                      <span class="w-2 h-2 bg-green-400 rounded-full"></span>
                                      <span class="text-slate-300">
                                          <span class="font-bold">Video Games</span>
                                          – My guilty pleasure and occasional source of inspiration.
                                      </span>
                                  </div>
                              </div>
                          </div>
                      </div>

                      <div class="bg-slate-700/50 rounded-xl p-4">
                          <h3 class="text-lg font-semibold text-white mb-3 flex items-center">
                              <svg class="w-5 h-5 mr-2 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                              </svg>
                              Why I Love Engineering
                          </h3>
                          <div class="grid grid-cols-1 gap-3">
                              <p>
                                  Engineering is fundamentally about finding elegant solutions to real problems and bringing them to life. Every project demands learning, questioning your assumptions, and pushing for that next level of optimization. Honestly, who wouldn't love that?
                              </p>
                              <p>
                                  What keeps it exciting is that no two problems are truly the same. You might encounter similar challenges across different teams or contexts, but each requires adapting your approach. It's an endless well of curiosity and discovery—and I'm here for it.
                              </p>
                          </div>
                      </div>

                      <div class="bg-gradient-to-r from-cyan-500/10 to-blue-500/10 border border-cyan-500/20 rounded-xl p-4">
                          <h3 class="text-lg font-semibold text-white mb-3 flex items-center">
                              <svg class="w-5 h-5 mr-2 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                              </svg>
                              Oh by the way are you hiring?
                          </h3>
                          <p>
                              I'm currently seeking a new opportunity with a company that empowers its technical teams to explore and innovate—not just maintain legacy systems, but actually invest time in proof-of-concepts and fresh solutions. Progress requires experimentation, and I want to work somewhere that gets that.
                          </p>
                          <p>
                              I also believe the best work environments are flexible. Remote work brings out my best, but I know that's not true for everyone. The right company understands that one-size-fits-all doesn't work and adapts to what helps each person thrive.
                          </p>
                          <p>
                              Ultimately, I'm looking for a place where I won't need side projects to satisfy my curiosity—where I can channel that energy into meaningful work alongside people who share the same passion for building something better.
                          </p>
                      </div>
                  </div>
              </ResumeSection>
          </div>

          <!-- Experience Section with Tree -->
          <div id="experience-section" class="resume-section">
            <ResumeSection
              title="Professional Journey"
              client:load
            >
              <div class="max-w-full">
                <ExperienceTree client:load />
              </div>
            </ResumeSection>
          </div>

          <!-- Education Section with Student Robot -->
          <div id="education-section" class="resume-section">
            <ResumeSection
              title="Academic Foundation"
              client:load
            >
              <div class="max-w-4xl mx-auto">
                <div class="text-center mb-8">
                  <StudentRobot client:load />
                  <p class="text-slate-300 text-lg mb-8">
                    Meet my student robot companion! Together we've built a solid foundation
                    in computer science and engineering principles.
                  </p>
                </div>

                <div class="space-y-6">
                  {education.map((edu, index) => (
                    <div class="bg-slate-800/30 rounded-xl p-6 border border-slate-700 hover:border-slate-600 transition-colors">
                      <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-3">
                        <div>
                          <div class="flex items-center mb-2">
                            <svg class="w-5 h-5 text-purple-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                            </svg>
                            <h3 class="text-xl font-semibold text-white">{edu.degree}</h3>
                          </div>
                          <p class="text-purple-400 font-medium ml-7">{edu.institution}</p>
                        </div>
                        <span class="text-slate-400 font-medium mt-2 md:mt-0">{edu.period}</span>
                      </div>
                      {edu.description && (
                        <p class="text-slate-300 ml-7">{edu.description}</p>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </ResumeSection>
          </div>


          <!-- Skills Section with Robot Assembler -->
          <div id="skills-section" class="resume-section">
            <ResumeSection
              title="Skills Assembly Lab"
              client:load
            >
              <div class="max-w-6xl mx-auto">
                <div class="text-center mb-12">
                  <p class="text-slate-300 text-lg mb-8">
                    Watch as my assembler robot builds new capabilities using my skills as parameters!
                    Each skill contributes to creating better solutions and innovations.
                  </p>
                </div>

                <RobotAssembler activeSkills={skills} client:load />

                <!-- Skills Grid -->
                <div class="grid md:grid-cols-2 gap-8 mt-16">
                  <!-- Technical Skills -->
                  <div class="bg-slate-800/20 rounded-xl p-6 border border-slate-700">
                    <h3 class="text-xl font-semibold text-white mb-6 flex items-center">
                      <svg class="w-5 h-5 text-cyan-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                      </svg>
                      Technical Arsenal
                    </h3>
                    <div class="space-y-4">
                      {skills.filter(skill => skill.category === 'technical').map((skill, index) => (
                        <div class="skill-item">
                          <div class="flex justify-between mb-2">
                            <span class="text-slate-300 font-medium">{skill.name}</span>
                            <span class="text-cyan-400 font-medium">{skill.level}%</span>
                          </div>
                          <div class="w-full bg-slate-700 rounded-full h-2">
                            <div
                              class="bg-gradient-to-r from-cyan-500 to-blue-500 h-2 rounded-full skill-bar"
                              style={`width: 0%`}
                              data-width={skill.level}
                            ></div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>

                  <!-- Soft Skills -->
                  <div class="bg-slate-800/20 rounded-xl p-6 border border-slate-700">
                    <h3 class="text-xl font-semibold text-white mb-6 flex items-center">
                      <svg class="w-5 h-5 text-purple-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                      </svg>
                      Leadership Qualities
                    </h3>
                    <div class="space-y-4">
                      {skills.filter(skill => skill.category === 'soft').map((skill, index) => (
                        <div class="skill-item">
                          <div class="flex justify-between mb-2">
                            <span class="text-slate-300 font-medium">{skill.name}</span>
                            <span class="text-purple-400 font-medium">{skill.level}%</span>
                          </div>
                          <div class="w-full bg-slate-700 rounded-full h-2">
                            <div
                              class="bg-gradient-to-r from-purple-500 to-pink-500 h-2 rounded-full skill-bar"
                              style={`width: 0%`}
                              data-width={skill.level}
                            ></div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </ResumeSection>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Resume section navigation
  document.addEventListener('DOMContentLoaded', () => {
      console.log('Resume page loaded');
    const navButtons = document.querySelectorAll('.resume-nav-btn');
    const sections = document.querySelectorAll('.resume-section');
    console.log("Nb navButtons: " + navButtons.length);
    console.log("Nb sections: " + sections.length);

    function showSection(sectionId: string) {
      console.log(sectionId);
      // Hide all sections
      sections.forEach(section => {
        section.classList.remove('active');
      });

      // Remove active class from all buttons
      navButtons.forEach(btn => {
        btn.classList.remove('active');
      });

      // Show selected section
      const selectedSection = document.getElementById(`${sectionId}-section`);
      if (selectedSection) {
        selectedSection.classList.add('active');
      }

      // Add active class to clicked button
      const activeBtn = document.querySelector(`[data-section="${sectionId}"]`);
      if (activeBtn) {
        activeBtn.classList.add('active');
      }

      // Animate skill bars if showing skills section
      if (sectionId === 'skills') {
        setTimeout(() => {
          const skillBars = document.querySelectorAll('.skill-bar');
          skillBars.forEach((bar, index) => {
            setTimeout(() => {
              const width = bar.getAttribute('data-width');
              (bar as HTMLElement).style.width = `${width}%`;
            }, index * 100);
          });
        }, 300);
      }
    }

    navButtons.forEach(button => {
      button.addEventListener('click', () => {
        const section = button.getAttribute('data-section');
        console.log("Section: " + section);
        if (section) {
          console.log("Truc1: " + section);
          showSection(section);
        }
      });
    });

    // Initialize skill bars
    const skillBars = document.querySelectorAll('.skill-bar');
    skillBars.forEach(bar => {
      (bar as HTMLElement).style.width = '0%';
    });
  });
</script>

<style>
  .resume-nav-btn {
    @apply bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white;
  }

  .resume-nav-btn.active {
    @apply bg-gradient-to-r from-cyan-500 to-blue-500 text-white shadow-lg;
  }

  .resume-section {
    @apply opacity-0 transform translate-y-4 absolute inset-0 pointer-events-none;
    transition: all 0.3s ease-in-out;
  }

  .resume-section.active {
    @apply opacity-100 transform translate-y-0 relative pointer-events-auto;
  }

  .skill-bar {
    transition: width 0.8s ease-in-out;
  }

  #resume-content {
    position: relative;
  }
</style>
