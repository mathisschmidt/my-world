---
import Layout from '../layouts/Layout.astro';
import {Article} from "../data/articles.ts";
import ArticleList from "../components/articles/ArticlesList.tsx";


const sortedTags = await Article.getAllTags()

// Sort posts by date (newest first)
const sortedArticles = await Article.getAllArticles()

const oldestDate = await Article.oldestDate()
---

<Layout title="Articles | Software Engineer Portfolio">
  <div class="min-h-screen py-10 px-6">
    <!-- Header -->
    <section class="max-w-4xl mx-auto text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">
        Technical Articles
      </h1>
      <p class="text-lg text-slate-300 mb-8 max-w-2xl mx-auto leading-relaxed">
        Explore my thoughts on software development, emerging technologies, and lessons learned from building projects.
      </p>
      
      <!-- Article Stats -->
      <div class="flex justify-center space-x-8 mb-8">
        <div class="text-center">
          <div class="text-2xl font-bold text-cyan-400">{sortedArticles.length}</div>
          <div class="text-slate-400 text-sm">Articles</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-blue-400">{sortedTags.length}</div>
          <div class="text-slate-400 text-sm">Topics</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-purple-400">
            {new Date().getFullYear() - oldestDate}
          </div>
          <div class="text-slate-400 text-sm">Years Writing</div>
        </div>
      </div>
    </section>

    <!-- Articles -->
    <ArticleList articles={sortedArticles} tags={sortedTags} client:load />
  </div>
</Layout>