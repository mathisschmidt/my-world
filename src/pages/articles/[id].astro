---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;

// Get related articles (same tags, excluding current article)
const relatedArticles = articles
  .filter(a => a.id !== article.id && a.tags.some(tag => article.tags.includes(tag)))
  .slice(0, 3);

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
};
---

<Layout title={`${article.title} | Articles`}>
  <div class="min-h-screen">
    <!-- Article Header -->
    <section class="py-20 px-6 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Back to Articles -->
        <div class="mb-8">
          <a 
            href="/articles" 
            class="inline-flex items-center text-cyan-400 hover:text-cyan-300 transition-colors"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Articles
          </a>
        </div>

        <!-- Article Meta -->
        <div class="mb-6">
          <time class="text-cyan-400 font-medium">
            {formatDate(article.date)}
          </time>
        </div>

        <!-- Article Title -->
        <h1 class="text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent leading-tight">
          {article.title}
        </h1>

        <!-- Article Description -->
        <p class="text-xl text-slate-300 mb-8 max-w-2xl mx-auto leading-relaxed">
          {article.description}
        </p>

        <!-- Tags -->
        <div class="flex flex-wrap justify-center gap-2 mb-8">
          {article.tags.map(tag => (
            <span class="px-3 py-1 bg-gradient-to-r from-cyan-500/10 to-blue-500/10 border border-cyan-500/20 text-cyan-300 text-sm font-medium rounded-full">
              {tag}
            </span>
          ))}
        </div>

        <!-- Reading Time -->
        <div class="text-slate-400 text-sm">
          <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          {Math.ceil(article.content.split(' ').length / 200)} min read
        </div>
      </div>
    </section>

    <!-- Article Content -->
    <section class="py-16 px-6">
      <div class="max-w-3xl mx-auto">
        <article class="prose prose-invert prose-lg prose-cyan max-w-none">
          <div class="article-content" set:html={article.content.split('\n').map(line => {
            if (line.startsWith('# ')) {
              return `<h1 class="text-3xl font-bold mb-6 text-white">${line.substring(2)}</h1>`;
            }
            if (line.startsWith('## ')) {
              return `<h2 class="text-2xl font-semibold mb-4 text-cyan-400 mt-8">${line.substring(3)}</h2>`;
            }
            if (line.startsWith('### ')) {
              return `<h3 class="text-xl font-semibold mb-3 text-white mt-6">${line.substring(4)}</h3>`;
            }
            if (line.startsWith('- ')) {
              return `<li class="text-slate-300 mb-2">${line.substring(2)}</li>`;
            }
            if (line.startsWith('```')) {
              return line.includes('```bash') ? 
                '<pre class="bg-slate-800 p-4 rounded-lg overflow-x-auto"><code class="text-green-400">' :
                '<pre class="bg-slate-800 p-4 rounded-lg overflow-x-auto"><code class="text-slate-300">';
            }
            if (line === '```') {
              return '</code></pre>';
            }
            if (line.trim() === '') {
              return '<br>';
            }
            return `<p class="text-slate-300 mb-4 leading-relaxed">${line}</p>`;
          }).join('')} />
        </article>
      </div>
    </section>

    <!-- Share Section -->
    <section class="py-12 px-6 bg-slate-800/30">
      <div class="max-w-3xl mx-auto text-center">
        <h3 class="text-xl font-semibold text-white mb-6">Share this article</h3>
        <div class="flex justify-center space-x-4">
          <a 
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(`${Astro.site}articles/${article.id}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 bg-slate-700 hover:bg-blue-600 text-slate-300 hover:text-white rounded-lg transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
          </a>
          <a 
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`${Astro.site}articles/${article.id}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 bg-slate-700 hover:bg-blue-700 text-slate-300 hover:text-white rounded-lg transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <button 
            onclick="copyToClipboard()"
            class="p-3 bg-slate-700 hover:bg-green-600 text-slate-300 hover:text-white rounded-lg transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
          </button>
        </div>
      </div>
    </section>

    <!-- Related Articles -->
    {relatedArticles.length > 0 && (
      <section class="py-16 px-6">
        <div class="max-w-6xl mx-auto">
          <h3 class="text-2xl font-bold text-white mb-8 text-center">Related Articles</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {relatedArticles.map((relatedArticle) => (
              <a 
                href={`/articles/${relatedArticle.id}`}
                class="block bg-slate-800/30 rounded-xl p-6 border border-slate-700 hover:border-slate-600 hover:bg-slate-800/50 transition-all duration-300 transform hover:-translate-y-1"
              >
                <div class="mb-3">
                  <time class="text-sm text-cyan-400 font-medium">
                    {formatDate(relatedArticle.date)}
                  </time>
                </div>
                <h4 class="text-lg font-semibold text-white mb-2 line-clamp-2">
                  {relatedArticle.title}
                </h4>
                <p class="text-slate-300 text-sm line-clamp-2 mb-3">
                  {relatedArticle.description}
                </p>
                <div class="flex flex-wrap gap-1">
                  {relatedArticle.tags.slice(0, 2).map(tag => (
                    <span class="px-2 py-1 bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-xs rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  function copyToClipboard() {
    navigator.clipboard.writeText(window.location.href).then(() => {
      // Show feedback
      const button = event.target.closest('button');
      const originalIcon = button.innerHTML;
      button.innerHTML = `
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      `;
      button.classList.add('bg-green-600');
      
      setTimeout(() => {
        button.innerHTML = originalIcon;
        button.classList.remove('bg-green-600');
      }, 2000);
    });
  }
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-content h1,
  .article-content h2,
  .article-content h3 {
    scroll-margin-top: 100px;
  }

  .article-content pre {
    position: relative;
  }

  .article-content pre code {
    font-family: 'JetBrains Mono', monospace;
  }
</style>