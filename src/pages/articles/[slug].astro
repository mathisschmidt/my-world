---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import {Article} from '../../data/articles';

export async function getStaticPaths() {
    const allArticles = await getCollection('articles');
    return allArticles.map(article => ({
        params: { slug: article.slug },
        props: { article },
    }));
}

const { article } = Astro.props;
const { Content } = await article.render();
const processedArticle = Article.fromAstroMdx(article);

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
};

// Import global article styles (Tailwind @apply file)
import "../../styles/article.css";
---

<Layout title={`${processedArticle.title} | Articles`}>
  <div class="min-h-screen">
    <!-- Article Header -->
    <section class="py-20 px-6 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Back to Articles -->
          <div class="mb-8">
              <a
                  href="/articles"
                  class="inline-flex items-center px-4 py-2 text-cyan-400 border border-cyan-500 rounded-md hover:bg-cyan-700 hover:text-white transition-all duration-300 ease-in-out shadow-md"
              >
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                  </svg>
                  Back to Articles
              </a>
          </div>

        <!-- Article Meta -->
        <div class="mb-6">
          <time class="text-cyan-400 font-medium">
            {formatDate(processedArticle.date)}
          </time>
        </div>

        <!-- Article Title -->
        <h1 class="text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent leading-tight">
          {processedArticle.title}
        </h1>

        <!-- Article Description -->
        <p class="text-xl text-slate-300 mb-8 max-w-2xl mx-auto leading-relaxed">
          <!--{processedArticle.description}--> description
        </p>

        <!-- Tags -->
        <div class="flex flex-wrap justify-center gap-2 mb-8">
          <!--{processedArticle.tags.map(tag => (
            <span class="px-3 py-1 bg-gradient-to-r from-cyan-500/10 to-blue-500/10 border border-cyan-500/20 text-cyan-300 text-sm font-medium rounded-full">
              {tag}
            </span>
          ))}-->
        </div>

        <!-- Reading Time -->
        <div class="text-slate-400 text-sm">
         <!-- <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          {Math.ceil(processedArticle.content.split(' ').length / 200)} min read-->
        </div>
      </div>
    </section>

    <!-- Article Content -->
    <section class="py-16 px-6">
      <div class="max-w-3xl mx-auto">
        <article class="prose prose-invert prose-lg prose-cyan max-w-none">
          <div class="article-content article-prose">
            <Content />
          </div>
        </article>
      </div>
    </section>
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>