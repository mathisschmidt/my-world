---
import Layout from '../layouts/Layout.astro';
import FloatingRobot from '../components/FloatingRobot.tsx';
import ArticleCard from '../components/ArticleCard.tsx';
import { profile } from '../data/profile';
import {Article} from "../data/articles.ts";

// Get the 3 most recent articles
const recentArticles = (await Article.getAllArticles()).slice(0, 3);
---

<Layout title="MathisWorld - Home">
  <div class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative min-h-[50vh] flex items-center justify-center px-6">
      <div class="absolute inset-0 bg-gradient-to-br from-cyan-900/20 via-slate-900 to-purple-900/20"></div>
      
      <!-- Floating Robot -->
      <FloatingRobot client:load />
      
      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-7xl font-bold mb-6 bg-gradient-to-r from-cyan-400 via-blue-400 to-purple-400 bg-clip-text text-transparent">
          {profile.name}
        </h1>
        <p class="text-xl md:text-2xl text-slate-300 mb-4 font-light">
          {profile.title}
        </p>
        <p class="text-lg text-slate-400 mb-8 max-w-2xl mx-auto leading-relaxed">
          {profile.bio}
        </p>
        
        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12">
          <a 
            href="/resume" 
            class="px-8 py-3 bg-gradient-to-r from-cyan-500 to-blue-500 text-white rounded-lg font-semibold hover:from-cyan-600 hover:to-blue-600 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-cyan-500/25"
          >
            View Resume
          </a>
          <a 
            href="/articles" 
            class="px-8 py-3 border border-slate-600 text-slate-300 rounded-lg font-semibold hover:bg-slate-800 hover:border-slate-500 transition-all duration-200"
          >
            Read Articles
          </a>
        </div>

        <!-- Social Links -->
        <div class="flex justify-center space-x-6">
          {profile.links.github && (
            <a 
              href={profile.links.github} 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-cyan-400 transition-colors p-2"
              aria-label="GitHub"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.374 0 0 5.373 0 12 0 17.302 3.438 21.8 8.207 23.387c.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
          )}
          {profile.links.linkedin && (
            <a 
              href={profile.links.linkedin} 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-blue-400 transition-colors p-2"
              aria-label="LinkedIn"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2">
        <div class="animate-bounce">
          <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>
      </div>
    </section>

    <!-- Recent Articles Section -->
    <section class="py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
            Latest Articles
          </h2>
          <p class="text-slate-400 text-lg max-w-2xl mx-auto">
            Discover my latest thoughts on software development, side projects, and other.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {recentArticles.map((article) => (
            <ArticleCard article={article} client:load />
          ))}
        </div>
        
        <div class="text-center mt-12">
          <a 
            href="/articles" 
            class="inline-flex items-center px-6 py-3 border border-slate-600 text-slate-300 rounded-lg font-semibold hover:bg-slate-800 hover:border-slate-500 transition-all duration-200"
          >
            View All Articles
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Quick Stats Section -->
    <!--<section class="py-20 px-6 bg-slate-800/50">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div class="space-y-2">
            <div class="text-3xl font-bold text-cyan-400">5+</div>
            <div class="text-slate-400">Years Experience</div>
          </div>
          <div class="space-y-2">
            <div class="text-3xl font-bold text-blue-400">articles.length</div>
            <div class="text-slate-400">Articles Written</div>
          </div>
          <div class="space-y-2">
            <div class="text-3xl font-bold text-purple-400">10+</div>
            <div class="text-slate-400">Technologies</div>
          </div>
          <div class="space-y-2">
            <div class="text-3xl font-bold text-green-400">50+</div>
            <div class="text-slate-400">Projects Completed</div>
          </div>
        </div>
      </div>
    </section>-->
  </div>
</Layout>
